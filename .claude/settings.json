{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Read(.claude/skills/**)",
      "mcp__atlassian__*",
      "mcp__claude_ai_Figma__*",
      "mcp__lokalise_pm__*",
      "mcp__lokalise_sd__*"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "zeroheight"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx \"$CLAUDE_PROJECT_DIR\"/.claude/skills/ai-agent-hooks/scripts/agent-workflow-guard.ts",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "figma-agent@bitso-design-skills": true
  }
}
